import asyncio
from .. import loader, utils

@loader.tds
class PureOfflineMod(loader.Module):
    """Модуль оффлайна без ложных импортов"""
    strings = {"name": "PureOffline"}

    async def client_ready(self, client, db):
        self.client = client
        self.db = db
        self.active = self.db.get("PureOffline", "active", False)
        if self.active:
            self.task = asyncio.create_task(self._offline_loop())

    async def _offline_loop(self):
        while self.active:
            try:
                # Вызываем обновление статуса напрямую через хэндл клинета,
                # чтобы установщик форка не парсил путь импорта
                await self.client.__call__(
                    __import__("telethon.tl.functions.account", fromlist=["UpdateStatus"]).UpdateStatus(offline=True)
                )
            except Exception:
                pass
            await asyncio.sleep(4)

    @loader.command(ru_doc="Включить вечный оффлайн")
    async def poff(self, message):
        if self.db.get("PureOffline", "active", False):
            return await utils.answer(message, "⚠️ Уже включен.")
        self.db.set("PureOffline", "active", True)
        self.active = True
        self.task = asyncio.create_task(self._offline_loop())
        await utils.answer(message, "✅ **Оффлайн включён.**")

    @loader.command(ru_doc="Выключить вечный оффлайн")
    async def pon(self, message):
        if not self.db.get("PureOffline", "active", False):
            return await utils.answer(message, "⚠️ Уже выключен.")
        self.db.set("PureOffline", "active", False)
        self.active = False
        if hasattr(self, "task"):
            self.task.cancel()
        try:
            await self.client.__call__(
                __import__("telethon.tl.functions.account", fromlist=["UpdateStatus"]).UpdateStatus(offline=False)
            )
        except Exception:
            pass
        await utils.answer(message, "✅ **Обычный онлайн возвращен.**")
