import asyncio
from .. import loader, utils

# Безопасный динамический импорт
try:
    from telethon import events
except ImportError:
    try:
        from hikkatl import events
    except ImportError:
        pass

@loader.tds
class UltimateAyuOfflineMod(loader.Module):
    """Максимальный оффлайн с перехватом твоих сообщений"""
    strings = {"name": "AyuOfflinePro"}

    async def client_ready(self, client, db):
        self.client = client
        self.db = db
        self.active = self.db.get("AyuOfflinePro", "active", False)
        self.task = None
        
        if self.active:
            self.task = asyncio.create_task(self._offline_loop())

    async def _get_packet(self):
        try:
            return __import__("telethon.tl.functions.account", fromlist=["UpdateStatus"]).UpdateStatus
        except Exception:
            return __import__("hikkatl.tl.functions.account", fromlist=["UpdateStatus"]).UpdateStatus

    async def _offline_loop(self):
        UpdateStatus = await self._get_packet()
        while self.active:
            try:
                await asyncio.gather(
                    self.client.__call__(UpdateStatus(offline=True)),
                    self.client.__call__(UpdateStatus(offline=True)),
                    return_exceptions=True
                )
            except Exception:
                pass
            await asyncio.sleep(1)

    async def watcher(self, message):
        """Следит за твоей активностью. Как только ты пишешь — бот мгновенно гасит онлайн"""
        if not self.active:
            return
        
        # Если сообщение отправлено тобой (с любого устройства)
        if getattr(message, "out", False):
            try:
                UpdateStatus = await self._get_packet()
                # Моментальный спам оффлайна вдогонку твоему сообщению
                await asyncio.gather(
                    self.client.__call__(UpdateStatus(offline=True)),
                    self.client.__call__(UpdateStatus(offline=True)),
                    return_exceptions=True
                )
            except Exception:
                pass

    @loader.command(ru_doc="Включить максимальный режим призрака")
    async def ayuon(self, message):
        self.db.set("AyuOfflinePro", "active", True)
        self.active = True
        if self.task:
            self.task.cancel()
        self.task = asyncio.create_task(self._offline_loop())
        await utils.answer(message, "👤 **Максимальный режим призрака активирован.**")

    @loader.command(ru_doc="Выключить режим призрака")
    async def ayuoff(self, message):
        self.db.set("AyuOfflinePro", "active", False)
        self.active = False
        if self.task:
            self.task.cancel()
            self.task = None
        try:
            UpdateStatus = await self._get_packet()
            await self.client.__call__(UpdateStatus(offline=False))
        except Exception:
            pass
        await utils.answer(message, "☀️ **Режим призрака отключен.**")
